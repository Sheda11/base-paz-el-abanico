# ==============================================================================
# Variables de Entorno de Ejemplo (.env.example)
# Copia este archivo a .env y ajusta los valores si es necesario
# ==============================================================================

DEBUG=True
SECRET_KEY=django-insecure-base-paz-el-abanico-clave-segura-desarrollo-2026
ALLOWED_HOSTS=localhost,127.0.0.1,*
TIME_ZONE=America/Caracas

# Configuración de Base de Datos (Opcional en desarrollo local - Fallback automático a SQLite)
# Para conectar a PostgreSQL en Docker o local, descomentar:
# POSTGRES_DB=base_paz_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres_secure_2026
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Broker y Backend de Celery (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Modo de pruebas para Celery (True = sincrónico en local; False = asíncrono con workers)
CELERY_ALWAYS_EAGER=True
